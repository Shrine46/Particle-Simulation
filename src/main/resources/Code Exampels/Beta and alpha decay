// New method in Main.java
private static final double NUCLEUS_FORMATION_DISTANCE_SQ = Math.pow(Main.getStrongForceOuterRadius() * 1.5, 2); // A bit more than strong force

private void detectAndFormNuclei() {
    List<Particle> potentialNucleons = new ArrayList<>();
    for (Particle p : particles) {
        if (p.isNucleon() && !particlesInNuclei.contains(p)) {
            potentialNucleons.add(p);
        }
    }

    List<Particle> processedInThisStep = new ArrayList<>(); // Avoid concurrent modification issues

    while (!potentialNucleons.isEmpty()) {
        Particle seed = potentialNucleons.remove(0);
        if (processedInThisStep.contains(seed)) continue;

        List<Particle> currentCluster = new ArrayList<>();
        currentCluster.add(seed);
        processedInThisStep.add(seed);

        List<Particle> toCheck = new ArrayList<>(currentCluster); // Queue for BFS-like search

        while(!toCheck.isEmpty()){
            Particle currentNucleon = toCheck.remove(0);
            for (Particle otherNucleon : potentialNucleons) {
                if (processedInThisStep.contains(otherNucleon)) continue;

                double dx = currentNucleon.getxCor() - otherNucleon.getxCor();
                double dy = currentNucleon.getyCor() - otherNucleon.getyCor();
                double dz = currentNucleon.getzCor() - otherNucleon.getzCor();
                double distSq = dx*dx + dy*dy + dz*dz;

                if (distSq < NUCLEUS_FORMATION_DISTANCE_SQ) {
                    currentCluster.add(otherNucleon);
                    processedInThisStep.add(otherNucleon);
                    toCheck.add(otherNucleon); // Add to queue
                }
            }
        }
         potentialNucleons.removeAll(processedInThisStep);


        if (currentCluster.size() > 1) { // Only form nucleus if more than one nucleon
            System.out.println("Forming nucleus with " + currentCluster.size() + " nucleons.");
            Nucleus newNucleus = new Nucleus(new ArrayList<>(currentCluster)); // Pass a copy
            activeNuclei.add(newNucleus);
            particlesInNuclei.addAll(currentCluster);
        }
    }

    // Maintenance: Remove nuclei if their constituent particles have drifted too far
    // or if the nucleus has become empty after decay.
    List<Nucleus> nucleiToRemove = new ArrayList<>();
    for (Nucleus nuc : activeNuclei) {
        nuc.recalculateCompositionAndPosition(); // Update Z, N, A
        if (nuc.getNucleons().isEmpty()) {
            nucleiToRemove.add(nuc);
            continue;
        }
        // Optional: Check if nucleons have drifted apart (strong force failed)
        // If so, dissolve nucleus and return particles to the main list.
    }
    for (Nucleus nucToRemove : nucleiToRemove) {
        System.out.println("Removing empty nucleus.");
        activeNuclei.remove(nucToRemove);
        // particlesInNuclei will be updated naturally as particles are removed/added
    }
}

private void processNucleiDecay() {
    List<Particle> newlyEmittedParticles = new ArrayList<>();
    List<Nucleus> nucleiToRemove = new ArrayList<>(); // For nuclei that fully decay

    for (Nucleus nuc : activeNuclei) {
        List<Particle> emitted = nuc.attemptDecay(particles, root, particleSpheres);
        if (!emitted.isEmpty()) {
            System.out.println("Nucleus Z=" + nuc.Z + ", N=" + nuc.N + " emitted " + emitted.size() + " particles.");
            for (Particle newP : emitted) {
                // Add to main simulation
                particles.add(newP);
                Sphere newSphere = new Sphere(newP.getRadius());
                // Set material based on newP.getParticleType()
                if (newP.getParticleType().equals("electron")) newSphere.setMaterial(electronMaterial);
                else if (newP.getParticleType().equals("positron")) { // Add positron material
                    PhongMaterial positronMaterial = new PhongMaterial(Color.CYAN); // Example
